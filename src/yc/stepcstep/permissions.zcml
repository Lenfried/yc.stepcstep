<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="yc.stepcstep">

  <configure zcml:condition="installed AccessControl.security">

    <permission
      id="yc.stepcstep.AddStepApplication"
      title="yc.stepcstep: Add STEP Application"
    />

    <permission
      id="yc.stepcstep.AddCstepApplication"
      title="yc.stepcstep: Add CSTEP Application"
    />

    <permission
      id="yc.stepcstep.ReviewApplication"
      title="yc.stepcstep: Review Application"
    />

    <permission
      id="yc.stepcstep.DecideApplication"
      title="yc.stepcstep: Decide Application"
    />

    <permission
      id="yc.stepcstep.ViewApplicantPII"
      title="yc.stepcstep: View Applicant PII"
    />

  </configure>

</configure>
