<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:plone="http://namespaces.plone.org/plone"
  i18n_domain="yc.stepcstep">

  <include package="plone.behavior" file="meta.zcml"/>

  <plone:behavior
    name="yc.stepcstep.applicant_identity"
    title="Applicant identity"
    description="Name, date of birth, contact details and address."
    provides=".applicant_identity.IApplicantIdentity"
  />

  <plone:behavior
    name="yc.stepcstep.economic_eligibility"
    title="Economic eligibility"
    description="Household size, income and disadvantage indicators."
    provides=".economic_eligibility.IEconomicEligibility"
  />

  <plone:behavior
    name="yc.stepcstep.eligibility_record"
    title="Eligibility record"
    description="Append-only audit trail of eligibility decisions."
    provides="yc.stepcstep.interfaces.IEligibilityRecord"
    factory=".eligibility_record.EligibilityRecord"
    marker="yc.stepcstep.interfaces.IEligibilityRecordMarker"
  />

</configure>
